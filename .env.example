# FPL API Authentication
# Copy this file to .env and fill in your credentials
# DO NOT commit your actual .env file to version control!

# Your FPL account email (the one you log into fantasy.premierleague.com with)
FPL_EMAIL=your_email@example.com

# Your FPL account password
FPL_PASSWORD=your_password_here

# Your FPL Team ID (find this in your FPL profile URL, e.g. https://fantasy.premierleague.com/entry/1234567)
FPL_TEAM_ID=1234567

# Optional: Your FPL league ID for league standings
FPL_LEAGUE_ID=

# Optional: API rate limiting (seconds between requests)
API_RATE_LIMIT=1.0

# Optional: Maximum retries for failed requests
API_MAX_RETRIES=3
